ycloid(in float t, in vec2 spec[183], in float rotation) {\n    vec2 o = v2;\n    float tu = t*6.28318530718; // time unit ;)\n    float freq = -91.*tu+rotation; float a = 0.;\n    for(int n=0;n<183;n++) {        \n        a = freq + spec[n].y;       // freq * t * 2*pi + phase\n        o += spec[n].x             // amplitude \n             * cos( a + vec2(0.,-1.57) ); // + vec2(0., -1/2*pi) gives cos(angle)+i*sin(angle)\n        freq += tu;\n    }\n    return zoom * o;\n}\n\n// 8< based on https://www.shadertoy.com/view/MlcGDB\n// draw line segment from A to B with given thickness r, \nfloat segment(in vec2 P, in vec2 A, in vec2 B, in float r) {\n    vec2 g = B - A;\n    vec2 h = P - A;\n    float d = length( h - g * clamp(dot(g, h) / dot(g,g), 0., 1.) );\n    return smoothstep(r, 0., d-r);    \n}\n// 8< end snip\n\nvoid mainImage( out vec4 C, in vec2 S )  {     // C=Color of the pixel, S=Screen coordinate of the pixel\n    // canvas coordinates\n    float line_width = 1./R.y;\n    vec2 uv = S.xy/vec2(R.y);\n    vec2 center = .5*R.xy/R.y;\n\n    // CALC\n    float t = iTime*0.2;\n    float phase = fract(t);\n\n    // READ\n    vec3 o = texelFetch(iChannel0, ivec2(S), 0).rgb;\n    vec4[] oldpos_texel = vec4[1] ( \n        vec4( 0. )\n    );\n    oldpos_texel[0] = texelFetch( iChannel0, MEMORY, 0 );\n\n    float rose_tilt = (iFrame > 0) ? oldpos_texel[0].z : 0.35; \n    float rose_ypos = (iFrame > 0) ? oldpos_texel[0].a : .2;\n\n    vec2 graph = epicycloid(fract(t), spectrum_flower, -rose_tilt ) + vec2( .0,-rose_ypos);\n    \n    vec3 color = mix(\n        vec3(.0,1.,.0),  // 0.\n        vec3(1.,.0,.0),  // 1.\n       ((phase > 0.308) && (phase < 0.85)) ? 1. : 0. \n    );\n\n    // DRAW\n    o = max( o, color * (\n        (iFrame==0) \n        ? smoothstep(line_width, 0., distance(uv, center+graph) )             // DOTS\n        : segment(uv, center+oldpos_texel[0].xy, center+graph, line_width) )  // LINES\n    );\n\n    // WRITE\n    C = vec4( o*0.995, 1.);\n    C = ( ivec2(S) == MEMORY ) ? vec4( graph, rose_tilt, rose_ypos) : C;         \n}\n","name":"Buffer A","description":"","type":"buffer"}],"flags":{"mFlagVR":false,"mFlagWebcam":false,"mFlagSoundInput":false,"mFlagSoundOutput":false,"mFlagKeyboard":false,"mFlagMultipass":true,"mFlagMusicStream":false},"info":{"id":"l3cyDl","date":"1735822116","viewed":126,"name":"Epicycloidean Rose","username":"Svenofnine","description":"Here is another shader based on a precalculated spectrum of rotating vectors (line 23+). The sum of these 183 vectors draw a rose when t runs from 0 .. 1. I use the phase to also choose the drawing color (line 106).\nEnjoy!","likes":12,"published":3,"flags":32,"usePreview":0,"tags":["fire","gradient","numbers","array","epicycloid"],"hasliked":0,"parentid":"4XccWs","parentname":"Basic Firefly Counter"}}