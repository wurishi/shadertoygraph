&15)+16*(XY.y&15);\n    int c=f11(n,int(xy.x)&7,int(xy.y)&15);\n    if((XY.x&32)>0) c=f14(n,int(xy.x)&7,int(xy.y)&15);\n    vec3 col=vec3(0.2,0.7,0.2)*vec3(c);\n    col=(0.125+0.5*col)*float(all(lessThan(vec2(XY&ivec2(31,-1)),vec2(16))))+0.25*col;\n    fragColor = vec4(col,1.0);\n}","name":"Image","description":"","type":"image"}],"flags":{"mFlagVR":false,"mFlagWebcam":false,"mFlagSoundInput":false,"mFlagSoundOutput":false,"mFlagKeyboard":false,"mFlagMultipass":false,"mFlagMusicStream":false},"info":{"id":"lXyBR3","date":"1738405367","viewed":188,"name":"Gohufont","username":"FordPerfect","description":"Embedded [url=https://font.gohu.org/]Gohufont[/url] (Latin-1 version, 191 char total), both 11px and 14px.\nGohufont is created by Hugo Chargois, released under [url=http://www.wtfpl.net/about/]WTFPL[/url].","likes":16,"published":3,"flags":0,"usePreview":0,"tags":["bitmap","font"],"hasliked":0,"parentid":"","parentname":""}}