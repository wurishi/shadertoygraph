tBitsToUint(v.z) + triple32(floatBitsToUint(v.w)))));\n}\n\n// any -> int\n#define hashi(v) int(hash(v));\n\n// any -> float\n#define hashf(v) (float(hash(v)) / 4294967295.);\n\n// end of hash functions\n// -------------------------------------------------\n","name":"Common","description":"","type":"common"}],"flags":{"mFlagVR":false,"mFlagWebcam":false,"mFlagSoundInput":false,"mFlagSoundOutput":false,"mFlagKeyboard":false,"mFlagMultipass":false,"mFlagMusicStream":false},"info":{"id":"MX3BR8","date":"1736931744","viewed":178,"name":"Single Function Semi Blue Noise","username":"beans_please","description":"Convolution with a white noise.\n\nHold mouse to see Shadertoy's default blue noise texture.","likes":9,"published":3,"flags":0,"usePreview":0,"tags":["noise","blue","hash","prng","low","rng","discrepency"],"hasliked":0,"parentid":"","parentname":""}}