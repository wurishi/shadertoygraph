[4] = float[4](1.0, 0.0, -1.0, 0.0);\nconst float Y_SHIFT[4] = float[4](0.0, 1.0, 0.0, -1.0);\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    float PIXEL_SHIFT = fragCoord.x - floor(fragCoord.x + 0.1);\n    float border = SIZE + PIXEL_SHIFT + 2.0;\n    bool insideMaze = fragCoord.x < border && fragCoord.y < border;\n    \n    // do nothing outside of the maze\n    if (!insideMaze) {\n        // the pixel at globalCrd represents the simulation phaze\n        float globalCrd = GLOBAL_CRD + PIXEL_SHIFT;\n        if (abs(fragCoord.x - globalCrd) < 0.1 && abs(fragCoord.y - globalCrd) < 0.1) {\n            vec4 result = texture(iChannel0, fragCoord / iResolution.xy);\n            bool isBfsPhase = result.x > 0.0;\n            if (isBfsPhase) {\n                result.z += 1.0;\n                float stopBfsTime = 0.66 * result.y;\n                float startCrd = 1.0 + PIXEL_SHIFT;\n                vec4 startCell = texture(iChannel0, vec2(startCrd) / iResolution.xy);\n                bool finishReached = startCell.z > 0.5;\n                if (result.z > stopBfsTime || finishReached) {\n                    result.z = 0.0;\n                    // switch back to maze bulding phase\n                    result.x = 0.0;\n                    result.y = float(int(result.y + 0.5) + 1);\n                }\n            } else {\n                int index = int(result.y + 0.5);\n                result.y = float(index + 1);\n\n                int dindex = index < 2500 ? 200 : 100;\n\n                // only build maze for the first 1300 steps\n                // after that do BFS each 200 steps, then each 100 steps\n                result.x = mix(result.x, 1.0, float(index > 1300 && index % dindex == 0));\n\n                // restart (from step N 2934 there is no path)\n                result = mix(result, vec4(0.0, 0.0, 0.0, 0.0), float(index > 3000));\n            }\n\n            fragColor = result;\n        }\n        return;\n    }\n\n    float CELL_SIZE = iResolution.y / CELL_SIZE_FACTOR;\n    vec2 uv = fragCoord/iResolution.xy;\n    vec4 result = texture(iChannel0, uv);\n    \n    vec4 globalState = texture(iChannel0, vec2(GLOBAL_CRD + PIXEL_SHIFT) / iResolution.xy);\n    bool mazeBuildPhase = globalState.x < 0.5;\n\n    // x color channel is the wall\n    if (mazeBuildPhase) {\n        int index = int(globalState.y);\n        result.x = mix(result.x, 0.0, float(index == 0));\n\n        int crd = maze[index];\n        float x = float(crd / 71) + 1.0 + PIXEL_SHIFT;\n        float y = float(crd % 71) + 1.0 + PIXEL_SHIFT;\n        \n        float isWall = float((abs(x - fragCoord.x) + abs(y - fragCoord.y)) < 0.1);\n        \n        result.x = max(result.x, isWall);\n        \n        float minCrd = PIXEL_SHIFT;\n        float maxCrd = SIZE + PIXEL_SHIFT + 1.0;\n        float isVertical = float(\n            ((abs(fragCoord.x - minCrd) < 0.1 || abs(fragCoord.x - maxCrd) < 0.1)));\n        \n        result.x = max(result.x, isVertical);\n\n        float isHorizontal = float(\n            ((abs(fragCoord.y - minCrd) < 0.1 || abs(fragCoord.y - maxCrd) < 0.1)));\n        \n        result.x = max(result.x, isHorizontal);\n    \n        result.y = 0.0;\n        result.z = max(0.0, 0.999 * (result.z - 0.02));\n        result.w = max(0.0, 0.999 * (result.w - 0.02));\n    } else {\n    \n        // y color channel is the distance from the start\n        // z color channel indicates whether the node is on the shortest path\n        float isStart = float((abs(fragCoord.x - 1.5) + abs(fragCoord.y - 1.5)) < 0.1);\n        float isFinish = float((abs(fragCoord.x - 71.5) + abs(fragCoord.y - 71.5)) < 0.1);\n        \n        float dist = mix(10000.0, 1.0, isStart);\n        float path = mix(0.0, 1.0, isFinish);\n        \n        for (int i = 0; i < 4; ++i) {\n            vec2 ngCoord = fragCoord + vec2(X_SHIFT[i], Y_SHIFT[i]);\n            vec4 ng = texture(iChannel0, ngCoord  / iResolution.xy);\n            float isClosestReachableNeighbor = float(\n                ng.x == 0.0 && ng.y > 0.0 && (ng.y + 1.0 < dist)\n            );\n            dist = mix(dist, ng.y + 1.0, isClosestReachableNeighbor); \n            path = mix(path, 1.0, float(ng.z == 1.0 && abs(ng.y - 1.0 - result.y) < 0.1));\n        }\n\n        result.y = dist * float(dist != 10000.0 && result.x == 0.0);\n        result.z = path * float(result.x == 0.0);\n        result.w = float(result.y > 0.5);\n     }\n    \n    \n    fragColor = result;\n}","name":"Buffer A","description":"","type":"buffer"}],"flags":{"mFlagVR":false,"mFlagWebcam":false,"mFlagSoundInput":false,"mFlagSoundOutput":false,"mFlagKeyboard":false,"mFlagMultipass":true,"mFlagMusicStream":false},"info":{"id":"M33yRl","date":"1735769390","viewed":71,"name":"Adventofcode 2024 - Day 18","username":"savegor","description":"A visualisation of https://adventofcode.com/2024/day/18","likes":7,"published":1,"flags":32,"usePreview":0,"tags":["maze","adventofcode"],"hasliked":0,"parentid":"","parentname":""}}