{"ver":"0.1","renderpass":[{"outputs":[{"channel":0,"id":"4dfGRr"}],"inputs":[],"code":"#define PI 3.14159265359\n\nfloat vort( vec2 uv )\n{\n    float d = dot(uv,uv);\n    float r = atan(uv.x,uv.y)/PI;\n    \n    float l = r + pow(d,.25) * 1.; l; l *= 2.; l -= iTime / 6.;\n    float h = abs(1.-mod(1.-l*6.,2.));\n    float p = step(.5, h);\n    \n    return p;\n}\n\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    vec2 uv = fragCoord/iResolution.xy;\n    uv -= .5; uv.x *= iResolution.x / iResolution.y;\n\n    vec2 S[16]; // MSAA\n    S[0] = vec2(0.5625, 0.5625)*2.-1.; S[1] = vec2(0.4375, 0.3125)*2.-1.;\n    S[2] = vec2(0.3125, 0.625)*2.-1.; S[3] = vec2(0.75, 0.4375)*2.-1.;\n    S[4] = vec2(0.1875, 0.375)*2.-1.; S[5] = vec2(0.625, 0.8125)*2.-1.;\n    S[6] = vec2(0.8125, 0.6875)*2.-1.; S[7] = vec2(0.6875, 0.1875)*2.-1.;\n    S[8] = vec2(0.375, 0.875)*2.-1.; S[9] = vec2(0.5, 0.0625)*2.-1.;\n    S[10] = vec2(0.25, 0.125)*2.-1.; S[11] = vec2(0.125, 0.75)*2.-1.;\n    S[12] = vec2(0.0, 0.5)*2.-1.; S[13] = vec2(0.9375, 0.25)*2.-1.;\n    S[14] = vec2(0.875, 0.9375)*2.-1.; S[15] = vec2(0.0625, 0.0)*2.-1.;\n\n    float m = 0.;\n    for (int i; i < 16; i++)\n    {\n        m += vort(uv+S[i]/iResolution.xy)/17.;\n    }\n    m += vort(uv-vec2(.5)/iResolution.xy)/17.;\n    vec3 c = mix(vec3(84., 224., 97.)/255., vec3(161., 255., 170.)/255., m);\n    \n    c = mix(c,vec3(1.),smoothstep(.1,1.5,pow(dot(uv,uv),.5))*.5);\n    \n    fragColor = vec4(c,1.0);\n}","name":"Image","description":"","type":"image"}],"flags":{"mFlagVR":false,"mFlagWebcam":false,"mFlagSoundInput":false,"mFlagSoundOutput":false,"mFlagKeyboard":false,"mFlagMultipass":false,"mFlagMusicStream":false},"info":{"id":"4XKfDK","date":"1738638945","viewed":40,"name":"Green spiral thingy","username":"KozyBobz","description":"I recently got into shader coding so i tried making this little spiral thingy.\nThis shader code is probably complete shit, but eh... I tried.","likes":2,"published":1,"flags":0,"usePreview":0,"tags":["time","spiral","green"],"hasliked":0,"parentid":"","parentname":""}}