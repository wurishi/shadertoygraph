gColor, in vec2 fragCoord ) {\n    vec2 uv = (fragCoord * 2. - iResolution.xy) / iResolution.y;\n\n    // Initialization\n    vec3 ro = vec3(0, -30, -45);         // ray origin\n    vec3 rd = normalize(vec3(uv * 2., 2.)); // ray direction\n        \n    vec3 col = vec3(1);               // final pixel color\n    float t = 0.; // total distance travelled\n\n    int i; // Raymarching\n    //if( uv.x < -1.0 || uv.x > 1.0 || uv.y < -1.0 || uv.y > 1.0){\n    //    t=100.0;\n    //}else{\n        for (i = 0; i < 40; i++) {\n            vec3 p = ro + rd * t; // position along the ray\n            float d = map(p);     // current distance to the scene\n            t += d;               // \"march\" the ray\n            if (d < .001 || t > 100.) break; // early stop\n        }\n    //}\n\n    // Coloring\n    if( t<100. )\n    {\n        vec3 pos = ro + t*rd;\n        vec3 nor = calcNormal(pos);\n        float dif = clamp( dot(nor,vec3(0.57703)), 0.0, 1.0 );\n        float amb = 0.5 + 0.5*dot(nor,vec3(0.0,1.0,0.0));\n        col = vec3(0.2,0.3,0.4)*amb + vec3(0.8,0.7,0.5)*dif;\n        //col = vec3(.2);\n    }\n    //col = vec3(t * .2);\n\n    // gamma        \n    // col = sqrt( col );\n    fragColor = vec4(col, 1);\n}","name":"Image","description":"","type":"image"}],"flags":{"mFlagVR":false,"mFlagWebcam":false,"mFlagSoundInput":false,"mFlagSoundOutput":false,"mFlagKeyboard":false,"mFlagMultipass":false,"mFlagMusicStream":false},"info":{"id":"43tBzf","date":"1737509427","viewed":25,"name":"Test Implicit Rendering Speed","username":"Ammarkhat","description":"Test Implicit Rendering Speed by rendering 219 spheres together.","likes":0,"published":1,"flags":0,"usePreview":0,"tags":["implicit"],"hasliked":0,"parentid":"","parentname":""}}