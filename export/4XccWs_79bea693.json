{"ver":"0.1","renderpass":[{"outputs":[{"channel":0,"id":"4dfGRr"}],"inputs":[{"channel":0,"type":"buffer","id":"4dXGR8","filepath":"/media/previz/buffer00.png","sampler":{"filter":"linear","wrap":"clamp","vflip":"true","srgb":"false","internal":"byte"}}],"code":"/*\nHappy new year 2025! -- svenofnine\nhttps://www.shadertoy.com/view/M3tyD2\n*/\n\n#define R iResolution\n\n// fire gradient - array of .r, .g, .b are colors and .a stores the position .0 .. .1 in the gradient. \nconst vec4[] fg = vec4 [] ( \n    //    r    g    b    a (=pos in gradient)\n    vec4( .0, .0, .0, .0),\n    vec4( .1, .1, .1, .1),\n    vec4( .3, .0, .0, .2),\n    vec4( 1., .4, .0, .5),\n    vec4( 1., 1., .3, .7),\n    vec4( 1., 1., 1., .8),\n    vec4( 1., 1., 1., 1.)\n);    \n\n// gradient() calculates a color at pos \"pos\" 0. .. 1. using definitions in the array fg (fire gradient).\n// First I wanted to pass the gradient as a parameter but then I thought it would be faster to\n// use the const directly instead to improve performance. So it is not neccessary to copy the whole array\n// into a function call for every single pixel. It's my imagination, maybe I am wrong and arrays\n// will be passed by reference like Javascript. We'll see.\nvec3 gradient( in float pos ) {\n    int num_cols = fg.length();\n    pos = clamp( pos, 0., 1.); // it needs to be in 0..1 range\n    for( int i = 0; i < num_cols-1; i++ ) \n      if( (pos >= fg[i].a) && (pos < fg[i+1].a) ) \n          return mix( \n              fg[i].rgb, \n              fg[i+1].rgb,\n              (pos - fg[i].a) / (fg[i+1].a - fg[i].a)\n          );\n    return fg[ num_cols-1 ].rgb;\n}\n\nvoid mainImage( out vec4 C, in vec2 S ) {\n    // lookup into the gradient and color the pixel\n    // S/R.xy = normalized coordinates of the screen (0..1) \n    C = (S.y>1.) ? vec4 ( gradient(2.*texture(iChannel0, S/R.xy).r), 1.) : vec4(.0);\n}","name":"Image","description":"","type":"image"},{"outputs":[{"channel":0,"id":"4dXGR8"}],"inputs":[{"channel"