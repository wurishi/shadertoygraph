), vec2( .1279,-1.651 ), \nvec2( .0122, 1.7053), vec2( .0635, 1.4763), vec2( .0155, 0.5951), vec2( .0626,-1.4399), vec2( .0366, 2.9701), \nvec2( .0275, 1.715 ), vec2( .0132,-2.5387), vec2( .0329,-1.2762), vec2( .0211,-0.0333), vec2( .008 , 1.182 ),\nv2,v2,v2,v2);\n \nvec2[] spectrum_seven = vec2[43] (\nv2,v2,v2,v2,v2,v2,v2,v2,v2,v2,\nvec2( .0242, 2.0733), vec2( .0126, 2.6556), vec2( .1109,-2.2871), vec2( .0466, 2.9133), vec2( .0471,-1.0175), \nvec2( .3996, 0.302),  vec2( .1048, 0.5075), vec2( .2977,-1.6974), vec2( .5199,-2.5263), vec2( .977,  2.5554), \nvec2( .56,   1.1514), vec2(1.1927, 1.78),   vec2(1.3962, 2.0733), vec2( .1757, 2.6556), vec2( .6466,-2.2871), \nvec2( .1398, 2.9133), vec2( .08,  -1.0175), vec2( .3996, 0.302 ), vec2( .0617, 0.5075), vec2( .0992,-1.6974), \nvec2( .0892,-2.5263), vec2( .0701, 2.5554), vec2( .0097, 1.1514),\nv2,v2,v2,v2,v2,v2,v2,v2,v2,v2);\n \nvec2[] spectrum_eight = vec2[43] (\nv2,v2,v2,v2,v2,v2,\nvec2( .0104, 0.9862), vec2( .0485,-2.7361), vec2( .0237,-0.2242), vec2( .0027, 1.4056), vec2( .0261, 1.6278), \nvec2( .0033, 1.1651), vec2( .0163, 0.5199), vec2( .0067, 2.6779), vec2( .0171, 2.5215), vec2( .1071,-1.2531), \nvec2( .0752, 1.2163), vec2( .0092, 0.588 ), vec2( .2539,-2.954),  vec2( .9356, 2.7372), vec2(1.0871, 2.1631), \nvec2( .7731, 1.5708), vec2(1.0697, 0.9862), vec2(1.227, -2.7361), vec2( .2578,-0.2242), vec2( .0156, 1.4056), \nvec2( .0913, 1.6278), vec2( .0074, 1.1651), vec2( .0242, 0.5199), vec2( .0067, 2.6779), vec2( .0115, 2.5215), \nvec2( .0478,-1.2531), vec2( .0215, 1.2163), vec2( .0016, 0.588 ), vec2( .0234,-2.954 ), vec2( .037,  2.7372), \nvec2( .0105, 2.1631),\nv2,v2,v2,v2,v2,v2);\n \nvec2[] spectrum_nine = vec2[43] (\nv2,v2,v2,v2,v2,v2,v2,\nvec2( .0136, 1.0664), vec2( .0653, 1.1458), vec2( .0358, 1.5102), vec2( .0307,-2.2921), vec2( .0313, 2.5017), \nvec2( .0323,-1.9779), vec2( .0769,-2.6861), vec2( .0948,-0.5865), vec2( .1029,-0.6069), vec2( .1387,-0.1805), \nvec2( .1749,-0.0953), vec2( .4038, 2.1712), vec2( .6173,-0.8194), vec2(1.0746, 2.3767), vec2( .1541,-0.0909), \nvec2(1.2337, 1.0664), vec2(1.4456, 1.1458), vec2( .3393, 1.5102), vec2( .1548,-2.2921), vec2( .0939, 2.5017), \nvec2( .0612,-1.9779), vec2( .0948,-2.6861), vec2( .0769,-0.5865), vec2( .0543,-0.6069), vec2( .0462,-0.1805), \nvec2( .0347,-0.0953), vec2( .0426, 2.1712), vec2( .0279,-0.8194), vec2( .0119, 2.3767),\nv2,v2,v2,v2,v2,v2,v2);\n\nivec2[] OLD_POS = ivec2[1] (\n    ivec2(0,0)\n);\n\n// draws an epicycloid graph defined as an array of vec3(freq, amplitude, phase)\n// the whole figure will be drawn in interval [ 0. <= t < 2*pi ] + k*2*pi \nvec2 epicycloid(in float t, in vec2 spec[43]) {\n    vec2 o = v2;\n    for(int n=0;n<43;n++) {        \n        if(spec[n].x > 0.)\n            o += spec[n].x             // amplitude \n                     * cos(\n                         (float(n)-21.)*t       // freq * t\n                         + spec[n].y       // + phase = angle;\n                         + vec2(0.,-1.57)  // + vec2(0., -1/2*pi) gives cos(angle)+i*sin(angle)\n                       );  \n    }\n    return zoom * o;\n}\n\n// 8< based on https://www.shadertoy.com/view/MlcGDB\n// draw line segment from A to B with given thickness r, \nfloat segment(in vec2 P, in vec2 A, in vec2 B, in float r) {\n    vec2 g = B - A;\n    vec2 h = P - A;\n    float d = length(h - g * clamp(dot(g, h) / dot(g,g), .0, 1.));\n    // return smoothstep(r, 0.5*r, d);     // original has bright points where segments overlap\n\treturn smoothstep(r, .5*r, d)-smoothstep(r,0.,length(h));  \n}\n// 8< end snip\n\nvec2[43] get_path(int num) {\n    switch( num % 10 ){\n        case 1: return spectrum_one;\n        case 2: return spectrum_two;\n        case 3: return spectrum_three;\n        case 4: return spectrum_four;\n        case 5: return spectrum_five;\n        case 6: return spectrum_six;\n        case 7: return spectrum_seven;\n        case 8: return spectrum_eight;\n        case 9: return spectrum_nine;\n    }\n    return spectrum_zero;\n}\n\nvoid mainImage( out vec4 C, in vec2 S )  {     // C=Color of the pixel, S=Screen coordinate of the pixel\n    // canvas coordinates\n    float unit = 1./R.y;\n    vec2 uv = S.xy/vec2(R.y);\n    vec2 center = .5*R.xy/R.y;\n\n    // CALC\n    int path_to_draw = int(floor(iTime));\n    float t = iTime;\n    vec2[] graph = vec2[1] (\n        epicycloid(fract(t)*6.28, get_path( path_to_draw ) ) + vec2( .0,-.05)\n    );\n\n    vec4[] oldpos_texel = vec4[1] ( \n        vec4( graph[0], v2)\n    );\n\n    // READ\n    float o = texelFetch(iChannel0, ivec2(S), 0).r;\n\n    // DRAW\n    if( (iFrame == 0) || (fract(t)<0.02) ) {\n        o = max( o, 1. - smoothstep(0., 6.*unit, distance(uv, center+graph[0]) ) );  // DOTS\n    } else {\n        oldpos_texel[0] = texelFetch( iChannel0, OLD_POS[0], 0 );\n        o = max( o, 1. * segment(uv, center+oldpos_texel[0].xy, center+graph[0], 3.*unit) );  // LINES \n    }\n\n    // smooth the whole buffer\n    C = (S.y>2.) \n        ? ( vec4( vec3(o), 1.)                               // sum up 5 pixels\n          +texelFetch(iChannel0, ivec2(S.x - 1., S.y), 0) \n          +texelFetch(iChannel0, ivec2(S.x + 1., S.y), 0) \n          +texelFetch(iChannel0, ivec2(S.x, S.y+1.), 0) \n          +texelFetch(iChannel0, ivec2(S.x, S.y-1.), 0) )\n          * .197                                            // divide by a bit more than 5 to slightly dim per frame\n        : C;\n\n // WRITE\n    C = ( ivec2(S) == OLD_POS[0] ) ? vec4( graph[0], 0, 0.) : C; \n\n}\n\n\n\n/*\n\n// saving vec3 format for reference --- vec3: .x = frequency -21...+21, .y = amplitude >0., .z = phase -pi..+pi\n\n#define v3 vec3(.0)\n\nvec3[] spectrum_zero = vec3[43] (\nv3,v3,v3,v3,v3,\nvec3( -16., .0219, 1.5991), vec3( -15.,  .0063,-1.3803), vec3( -14., .0114,-1.4261), vec3( -13., .0038,  1.5965), vec3( -12., .0497, 1.4468), \nvec3( -11., .0354,-1.5796), vec3( -10.,  .0338,-1.7034), vec3(  -9., .0348, 1.8141), vec3(  -8., .0674,  1.5777), vec3(  -7., .1157,-1.536